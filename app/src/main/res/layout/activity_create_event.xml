<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.CreateEventActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_weight="1"
                style="@style/H1"
                android:textSize="16sp"
                android:text="Create New Event"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="Plant" />

            <Spinner
                android:id="@+id/plantSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:paddingStart="18dp"
                android:paddingBottom="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="Name"
                />

            <EditText
                android:id="@+id/name"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:layout_width="match_parent"
                android:hint="Enter the name of the event"
                style="@style/MainInput"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="Description"
                />

            <EditText
                android:id="@+id/description"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:layout_width="match_parent"
                android:hint="Enter the description of the event"
                style="@style/MainInput"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="Date"
                />

            <EditText
                android:id="@+id/date"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:layout_width="match_parent"
                android:hint="Enter the date of the event"
                style="@style/MainInput"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="Volunteers Needed"
                />

            <EditText
                android:id="@+id/volunteersNeeded"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:layout_width="match_parent"
                android:inputType="number"
                android:hint="Enter the name of volunteers needed"
                style="@style/MainInput"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/create"
            android:background="@drawable/button_bg"
            android:layout_width="match_parent"
            android:fontFamily="monospace"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="Create"
            android:layout_height="50dp"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
